# ═══════════════════════════════════════════════════════════════════════════════
# Test Management Tool - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control!
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server Configuration ──────────────────────────────────────────────────────
SERVER_PORT=8080

# ── Database Configuration ────────────────────────────────────────────────────
DATASOURCE_URL=jdbc:postgresql://localhost:5432/tmt_db
DATASOURCE_USER=your_db_user
DATASOURCE_PASSWORD=your_secure_db_password

# ── JWT Configuration ─────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your_64_character_or_longer_secret_key_here_make_it_random_and_secure
JWT_EXPIRATION=86400000

# ── Frontend URL ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── CORS Configuration ────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── File Upload Directory ─────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Logging ───────────────────────────────────────────────────────────────────
APP_LOG_LEVEL=DEBUG
SECURITY_LOG_LEVEL=INFO
JPA_SHOW_SQL=false

# ── File Upload Limits ────────────────────────────────────────────────────────
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=50MB

# ── JIRA Integration (Optional) ───────────────────────────────────────────────
JIRA_ENABLED=false
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=PROJECT
JIRA_ISSUE_TYPE=Bug

# ── Default Admin Configuration (Optional) ───────────────────────────────────
# Set DEFAULT_ADMIN_ENABLED=true to auto-create admin user on startup
DEFAULT_ADMIN_ENABLED=false
DEFAULT_ADMIN_EMAIL=admin@yourcompany.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=YourSecurePassword123!
DEFAULT_ADMIN_FULLNAME=Platform Admin
DEFAULT_ADMIN_TEAM=Platform
