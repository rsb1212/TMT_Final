[Unit]
Description=Test Management Tool Backend - SmartQA
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/html/TestManagementSystem/backend

# Environment variables
Environment="SERVER_PORT=8080"
Environment="DATASOURCE_URL=jdbc:postgresql://localhost:5566/tmt_uat"
Environment="DATASOURCE_USER=postgres"
Environment="DATASOURCE_PASSWORD=root@123"
Environment="UPLOAD_DIR=/var/www/html/TestManagementSystem/uploads"
Environment="CORS_ALLOWED_ORIGINS=http://10.3.41.102,http://10.3.41.102:80"
Environment="JWT_SECRET=SmartQA$2026!SecureTokenKey@Production#Server102%RandomString789"
Environment="JWT_EXPIRATION=86400000"
Environment="FRONTEND_URL=http://10.3.41.102"
Environment="APP_LOG_LEVEL=INFO"
Environment="SECURITY_LOG_LEVEL=WARN"
Environment="JPA_SHOW_SQL=false"
Environment="MAX_FILE_SIZE=100MB"
Environment="MAX_REQUEST_SIZE=100MB"

# Java options - optimized for production
Environment="JAVA_OPTS=-Xms512m -Xmx2048m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/var/www/html/TestManagementSystem/logs/"

ExecStart=/usr/bin/java $JAVA_OPTS -jar /var/www/html/TestManagementSystem/backend/test-management-tool-1.0.0.jar

# Restart policy
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=testmanagement

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/html/TestManagementSystem/uploads /var/www/html/TestManagementSystem/logs

[Install]
WantedBy=multi-user.target